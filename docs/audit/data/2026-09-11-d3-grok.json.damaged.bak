          {
            "name": "DEFAULT_MAX_BACKGROUND_TASKS",
            "value": "10",
            "evidence": "crates/codegen/xai-grok-shell-terminal/src/background_task.rs:59"
          },
          {
            "name": "OUTPUT_RING_BUFFER_SIZE / OUTPUT_BATCH_INTERVAL_MS",
            "value": "256*1024 bytes / 16 ms",
            "evidence": "crates/codegen/xai-grok-shell-terminal/src/pty_session.rs:52-53"
          }
        ],
        "evidence": [
          "crates/codegen/xai-grok-shell-terminal/src/lib.rs:38-39",
          "crates/codegen/xai-grok-shell-terminal/src/local_terminal.rs:114-159",
          "crates/codegen/xai-grok-shell-terminal/src/streaming_local_terminal.rs:517-519",
          "crates/codegen/xai-grok-shell-terminal/src/pty_session.rs:52-53"
        ],
