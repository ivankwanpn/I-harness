            "name": "BUSY_RETRY_BUDGET",
            "value": "10 s (inner retries share one deadline)",
            "evidence": "crates/codegen/xai-sqlite-journal/src/lib.rs:23"
          },
          {
            "name": "RETRY_PAUSE",
            "value": "20 ms, with a per-attempt busy clamp of 20 ms..1000 ms",
            "evidence": "crates/codegen/xai-sqlite-journal/src/lib.rs:236-240"
          },
          {
            "name": "host tag / hostname cap",
            "value": "\".h-{host}\" / 24 chars",
            "evidence": "crates/codegen/xai-sqlite-journal/src/lib.rs:121, :306"
          }
        ],
