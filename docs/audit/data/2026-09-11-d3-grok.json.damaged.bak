          {
            "name": "STREAM_DRAIN_TIMEOUT",
            "value": "5 s",
            "evidence": "crates/codegen/xai-grok-shell/src/session/acp_session_impl/sampler_turn.rs:263"
          },
          {
            "name": "BASH_MODE_TIMEOUT",
            "value": "3600 s",
            "evidence": "crates/codegen/xai-grok-shell/src/session/acp_session_impl/tool_dispatch.rs:9"
          },
          {
            "name": "lock path keys",
            "value": "file_path | path | target_file",
            "evidence": "crates/codegen/xai-grok-shell/src/session/acp_session_impl/tool_dispatch.rs:54"
          }
        ],
        "evidence": [
