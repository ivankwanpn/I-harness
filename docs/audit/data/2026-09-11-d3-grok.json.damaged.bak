          "crates/codegen/xai-grok-sandbox/src/profiles.rs:26-43",
          "crates/codegen/xai-grok-sandbox/src/profiles.rs:114-167",
          "crates/codegen/xai-grok-sandbox/src/profiles.rs:183-200"
