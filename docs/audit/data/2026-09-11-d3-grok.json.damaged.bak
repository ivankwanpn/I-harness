            "name": "enforce feature",
            "value": "on by default; without it the crate is helpers-only and nothing is kernel-enforced",
            "evidence": "crates/codegen/xai-grok-sandbox/src/lib.rs:13-15"
          }
        ],
        "evidence": [
          "crates/codegen/xai-grok-sandbox/src/lib.rs:8-15",
          "crates/codegen/xai-grok-sandbox/src/lib.rs:100-106",
          "crates/codegen/xai-grok-sandbox/src/lib.rs:179-262"
