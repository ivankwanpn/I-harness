  "unmergedDoubts": [
    {
      "mechanisms": [
        "dsh:driver-wake-latch-and-maintenance-phase",
        "opencode:v2-run-coordinator-coalescing",
        "opencode-fork:kernel-durable-turn-coordinator"
      ],
      "whyNotMerged": "三者都在協調喚醒與忙碌所有權，但 v2 協調器同時做喚醒合併與 successor 鏈接，dsh 的驅動器做喚醒閂鎖與維護相位，kernel 協調器則把釋放綁在持久結算後；同名為協調、實作單位不同，未合併。"
    },
    {
      "mechanisms": [
        "cc-custom:sequential-effect-state-machine",
        "cc-custom:effect-scoped-abort-and-cleanup",
        "cc-custom:abort-and-interrupt-semantics"
      ],
      "whyNotMerged": "cc-custom 的運行時在三列間高度耦合：每轉換一效果的約束屬迴圈本體，效果級控制器生命週期屬中止清理，abort 原因與 ownsAbort 屬中止語意；拆分是為了讓各列與其他來源對齊。"
    },
    {
      "mechanisms": [
        "opencode:session-runner-serialization",
        "opencode:session-execution-routing",
        "opencode-fork:session-serialized-runner",
        "opencode-fork:engine-fixed-at-session-creation"
      ],
      "whyNotMerged": "上游兩列在 fork 幾乎以同名重複；因無法斷言 fork 的 routing 與 kernel 選擇與上游逐行等價，仍以不同列呈現，供人工核對。"
    },
    {
      "mechanisms": [
        "dsh:durable-inbox-projection",
        "opencode:queued-task-dispatch",
        "grok:turn-bound-safe-point-delivery"
      ],
      "whyNotMerged": "grok 的 Pending/Projecting/Delivered 三態在記憶體生命週期內運作，IH 與 dsh 是日誌投影；已合併為一列，但「提交前暫存槽」與「持久待處理列」的層級差異未被完整表達。"
    },
    {
      "mechanisms": [
        "grok:delivery-envelope-identity-triple-check",
        "grok:source-typed-operation-authorization"
      ],
      "whyNotMerged": "兩者同屬輸入准入：一為來源授權，一為身分與 grant 綁定；已併為一列，但 grant 的目標會話範圍其實與每會話序列化列相關。"
    },
    {
      "mechanisms": [
        "ih:session-log-driven-turn-loop.maxTurns",
        "cc-custom:turn-budget-ladder",
        "codex:session-rollout-token-budget-ladder"
      ],
      "whyNotMerged": "IH 的 maxTurns 只是常數，未列入預算列；若日後把回合數上限視為預算的一種，這一歸屬需要重新檢視。"
    },
    {
      "mechanisms": [
        "grok:canonical-turn-event-log",
        "opencode:turn-title-generation",
        "dsh:default-agent-model-selection"
      ],
      "whyNotMerged": "三者列在 loop 陣列但語意分別屬會話持久化、檢索記憶與模型域；為保完整計數仍各成一列，並以路線差異標示，未與迴圈機制合併。"
    },
    {
      "mechanisms": [
        "opencode:v2-run-coordinator-coalescing",
        "opencode:background-job-registry"
      ],
      "whyNotMerged": "兩者都在管生命週期與取消，但一個是每鍵序列化與喚醒合併，一個是工作狀態登記與升遷；opencode 自身的 interrupt-finalization 已把背景工作取消級聯算進中止語意，故此處只放登記本體以避免重複計數。"
    },
    {
      "mechanisms": [
        "cc-custom:proactive-self-tick-loop",
        "cc-custom:speculative-turn-execution"
      ],
      "whyNotMerged": "兩者都是無明確使用者輸入即啟動回合，但觸發來源不同（計時器自跳與預測輸入）；且 speculative 會先寫入真實回合再注入，與 IH 的失敗關閉原則牴觸，已分別列為 rewrite 與不做。"
    }
  ],
