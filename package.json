{
  "name": "@i-harness/root",
  "private": true,
  "version": "0.1.0",
  "description": "I-harness agent runtime monorepo",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10"
  },
  "scripts": {
    "test": "pnpm -r --no-bail test && pnpm test:quarantine",
    "test:default": "pnpm -r --no-bail test",
    "test:quarantine": "pnpm --filter @i-harness/tui test:quarantine",
    "typecheck": "pnpm -r typecheck",
    "e2e": "vitest run e2e/ --config e2e/vitest.config.ts",
    "verify:store": "bash scripts/check-store.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.28.2"
  }
}
