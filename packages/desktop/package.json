{
  "name": "@i-harness/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-attachment-reader.mjs && electron-vite dev",
    "build": "electron-vite build && node scripts/build-attachment-reader.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gateway:ship": "node scripts/build-gateway.mjs",
    "attachment:build": "node scripts/build-attachment-reader.mjs",
    "dist": "electron-vite build && node scripts/build-attachment-reader.mjs && node scripts/build-gateway.mjs && node scripts/package-app.mjs",
    "installer": "node scripts/build-installer.mjs",
    "installer:test": "node test/installer-lifecycle.mjs",
    "installer:destination": "node test/installer-destination.mjs"
  },
  "dependencies": {
    "@i-harness/desktop-gateway": "workspace:*",
    "@i-harness/fs-search": "workspace:*",
    "@i-harness/sdk": "workspace:*",
    "@tanstack/react-virtual": "3.14.13",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "lucide-react": "0.469.0",
    "koffi": "3.1.6",
    "pdfjs-dist": "6.3.289",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.4.5",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.0"
  }
}
